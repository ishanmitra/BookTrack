# Server (server/index.js) — copy to server/.env and fill in
PORT=4000
# When set, every /api request must send the matching x-api-key header.
API_KEY=
# Legacy admin key for DELETE /api/books/:id (still honored); admin session users also work.
ADMIN_TOKEN=
# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub user ids (numeric) and/or login names granted admin.
GITHUB_ADMIN_IDS=
# Where to land after OAuth login (default: "/")
REDIRECT_URL=

# Client build (Vite) — exposed to the browser bundle, so use throwaway values
# in production; real protection comes from OAuth + server identity.
VITE_API_KEY=
VITE_ADMIN_TOKEN=