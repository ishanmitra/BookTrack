# Server (server/index.js)
PORT=4000
# When set, every /api request must send the matching x-api-key header.
API_KEY=
# When set, DELETE /api/books/:id requires the matching x-admin-key header.
ADMIN_TOKEN=

# Client build (Vite) — exposed to the browser bundle, so use throwaway values
# in production; real protection comes from OAuth + server identity later.
VITE_API_KEY=
VITE_ADMIN_TOKEN=