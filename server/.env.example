# Copy to server/.env and fill in.
PORT=4000
# DB: leave unset to use the local embedded engine (data/reader.db). Set
# TURSO_DATABASE_URL (+ TURSO_AUTH_TOKEN) to use a remote Turso/libsql DB.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# When set, every /api request must send the matching x-api-key header.
API_KEY=
# GitHub OAuth app credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub user ids (numeric) and/or login names granted admin.
GITHUB_ADMIN_IDS=
# Comma-separated GitHub user ids (numeric) and/or login names granted the
# super-admin role. Bootstraps the first super admin on a fresh DB (self-heal
# when there's a vacancy); add your own id to test role management locally.
GITHUB_SUPER_ADMIN_IDS=
# Where to land after OAuth login (default: "/")
REDIRECT_URL=